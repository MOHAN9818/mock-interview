PORT=5001
FALLBACK_PORT=5002
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.iezgtff.mongodb.net/mockinterview?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Camera Monitoring & Integrity Scoring Policy (Optional)
# Options for INTEGRITY_PENALTY_POLICY:
# - standard (default): Flags for review (REVIEW_REQUIRED) without automatic score deduction
# - deduction: Deducts points based on FLAT_PENALTY + per-warning penalty
# - zero_score: Policy-based zero score when threshold is exceeded, preserving raw score for audit
INTEGRITY_PENALTY_POLICY=standard
INTEGRITY_FLAT_PENALTY=20
INTEGRITY_PER_WARNING_PENALTY=5
