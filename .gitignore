# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
# Block all .env variations across root and subfolders
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env

# Allow safe example files as templates
!.env.example
!client/.env.example
!server/.env.example

# Secret keys, private certs, tokens and credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pkcs12
*serviceAccountKey*.json
*service-account*.json
credentials.json
secrets/

# ==========================================
# Dependencies
# ==========================================
node_modules/
*/node_modules/
server/node_modules/
client/node_modules/
.pnpm-store/

# ==========================================
# Production & Distribution Builds
# ==========================================
dist/
*/dist/
build/
*/build/
out/
.parcel-cache/
.cache/

# ==========================================
# Logs & Runtime Diagnostics
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Test & Coverage Artifacts
# ==========================================
coverage/
*.lcov
.nyc_output/

# ==========================================
# Operating System & IDE Files
# ==========================================
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
