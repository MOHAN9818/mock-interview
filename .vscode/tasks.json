{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start API",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/server",
        "env": {
          "PORT": "5001",
          "FALLBACK_PORT": "5000"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Start frontend",
      "type": "shell",
      "command": "npm run dev -- --host 0.0.0.0 --strictPort",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "problemMatcher": []
    }
  ]
}
